class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        if(head==null || head.next==null){
            return null;
        }
        int size=0;
        ListNode next=head;
        while(next!=null){
            size++;
            next=next.next;
        }
        if(size==n){
            return head.next;
        }
        ListNode curr=head;
        ListNode prev=head;
        int pos=size-n;
        for(int i=1;i<=pos;i++){
            prev=curr;
            curr=curr.next;
        }
        prev.next=curr.next;
        return head;
    }
}
